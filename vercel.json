{
  "rewrites": [
    {
      "source": "/boardlife/:path*",
      "destination": "https://boardlife.co.kr/:path*"
    },
    {
      "source": "/bgg-api/:path*",
      "destination": "https://api.geekdo.com/:path*"
    },
    {
      "source": "/xmlapi2/:path*",
      "destination": "https://boardgamegeek.com/xmlapi2/:path*"
    },
    {
      "source": "/translate-api/:path*",
      "destination": "https://translate.googleapis.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
